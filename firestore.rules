rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all posture to protect unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Validates if the user is the authorized administrator
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'donchid.online@gmail.com';
    }

    // 1. PROJECTS COLLECTION: Public viewable, Admin-only write privileges
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. BLOGS COLLECTION: Public viewable, Admin-only write privileges
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2b. SERVICES COLLECTION: Public viewable, Admin-only write privileges
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2c. TESTIMONIALS COLLECTION: Public viewable, Admin-only write privileges
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2d. SETTINGS COLLECTION: Single site-config doc (author identity, avatar,
    //     editorial title). Public read so blogs can show the author byline;
    //     admin-only write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. CONTACTS COLLECTION: Written only by the backend Cloud Function (Admin SDK).
    //    Public read, write, update, delete are denied. Admin can view & delete.
    match /contacts/{contactId} {
      // Admin clearance required to view inquiry messages or delete them
      allow read, delete: if isAdmin();
      
      // Contact submissions can never be edited once submitted to preserve integrity
      allow update: if false;

      // Public visitors cannot write directly — submissions go through the
      // sendContactEmail callable function (Admin SDK), which validates, rate-limits,
      // and persists the lead server-side.
      allow create: if false;
    }
  }
}
