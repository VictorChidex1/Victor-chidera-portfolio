rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all posture to protect unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Validates if the user is the authorized administrator
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'donchid.online@gmail.com';
    }

    // 1. PROJECTS COLLECTION: Public viewable, Admin-only write privileges
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. BLOGS COLLECTION: Public viewable, Admin-only write privileges
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. CONTACTS COLLECTION: Public submission (validated), Admin-only view & delete
    match /contacts/{contactId} {
      // Admin clearance required to view inquiry messages or delete them
      allow read, delete: if isAdmin();
      
      // Contact submissions can never be edited once submitted to preserve integrity
      allow update: if false;

      // Public visitor form submission validation (Bot & Payload Injection filtering)
      allow create: if 
        // 1. Mandatory structural presence and exact schema match
        request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt']) &&
        
        // 2. Name validation: Non-empty string
        request.resource.data.name is string && 
        request.resource.data.name.trim().size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        
        // 3. Email validation: Simple valid regex matching
        request.resource.data.email is string && 
        request.resource.data.email.matches('.+@.+\\..+') &&
        
        // 4. Message validation: Length constraint preventing huge binary payload spam or scripting
        request.resource.data.message is string && 
        request.resource.data.message.trim().size() >= 5 && 
        request.resource.data.message.size() <= 3000 &&
        
        // 5. Server timestamp validation: Prevents spoofed/client-modified submission timestamps
        request.resource.data.createdAt == request.time;
    }
  }
}
