{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "npm run build",
      "node scripts/prerender-hubs.ts"
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "run": { "serviceId": "seositemap", "region": "us-central1" }
      },
      {
        "source": "/api/og",
        "run": { "serviceId": "ogimage", "region": "us-central1" }
      },
      {
        "source": "/api/og/**",
        "run": { "serviceId": "ogimage", "region": "us-central1" }
      },
      {
        "source": "/img/**",
        "run": { "serviceId": "imageresize", "region": "us-central1" }
      },
      {
        "source": "**",
        "run": { "serviceId": "seogateway", "region": "us-central1" }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  }
}
