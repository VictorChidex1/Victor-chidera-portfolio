rules_version = '2';

// Firebase Storage security rules.
// Posture: public read for display images, admin-only writes, image-only,
// size-capped, path-scoped. Everything else is denied by default.
service firebase.storage {
  match /b/{bucket}/o {

    // The single authorized administrator.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'donchid.online@gmail.com';
    }

    // Shared write guard for uploads: image MIME + max 5MB.
    // (Only applies to create/update; deletes have no request.resource.)
    function isValidImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png|avif|gif)');
    }

    // Project cover images.
    match /projects/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Blog cover images.
    match /blog-covers/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Testimonial avatars.
    match /testimonials/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Site settings avatar (author photo).
    match /settings/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // SEO snapshots (written by the Admin SDK, which bypasses rules) and any
    // unmapped path: deny all client access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
